# SPIN ETHIOPIA ENVIRONMENT VARIABLES

# Database Connection (Production PostgreSQL)
# Required for persistent production storage (Neon, Supabase, Render, Railway, AWS RDS, etc.)
DATABASE_URL=

# Authentication & Session Security
# Secret key used to sign and secure user sessions and tokens
AUTH_SECRET=
JWT_SECRET=
SESSION_SECRET=

# Admin Account Default Password (default admin phone: 0929200166)
ADMIN_DEFAULT_PASSWORD=

# Application & Network Configuration
PORT=3000
FRONTEND_URL=
APP_URL=

# Client-side Backend URL (Only needed if frontend on Vercel connects to a separate backend server)
VITE_API_URL=

# Vercel Serverless Proxy (Set on Vercel to forward /api requests to your always-on backend)
ALWAYS_ON_BACKEND_URL=

# 24/7 Game Worker Automation Settings
AUTO_DRAW_WHEN_FULL=false
START_WORKER=true

